# Twelve Data API key — https://twelvedata.com/account/api-key
TWELVE_DATA_API_KEY=your_key_here

# OpenWeatherMap API key
WEATHER_API_KEY=your_key_here

# Voice Command System – Vosk Offline-Spracherkennung
# Modell herunterladen mit: bash scripts/download_voice_model.sh
# Verfügbare Modelle: https://alphacephei.com/vosk/models
#   Kompakt (~45 MB):   vosk-model-de-0.21
#   Genauer (~1.6 GB):  vosk-model-de-0.21-lgraph
VOICE_MODEL_PATH=./models/vosk-model-de-0.21
VOICE_ENABLED=True
